{
  "name": "new-trello-git",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n ui,api -c cyan,green \"vite\" \"wrangler dev --port 8787\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "db:init:local": "wrangler d1 execute new-trello-db --local --file=migrations/0001_initial.sql",
    "db:migrate:local": "wrangler d1 execute new-trello-db --local --file=migrations/0001_initial.sql",
    "db:migrate:remote": "wrangler d1 execute new-trello-db --remote --file=migrations/0001_initial.sql",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && wrangler dev"
  },
  "dependencies": {
    "@hono/zod-openapi": "0.18.4",
    "hono": "4.7.10",
    "lucide-preact": "0.575.0",
    "preact": "10.25.4",
    "preact-router": "4.1.2",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.9.4",
    "concurrently": "9.1.2",
    "typescript": "5.7.3",
    "vite": "6.3.5",
    "wrangler": "4.90.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "packageManager": "pnpm@11.1.3"
}
